<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Luilaykhao</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>GMSApiKey</key>
		<string>$(GOOGLE_MAPS_API_KEY)</string>
		<key>CFBundleName</key>
		<string>Luilaykhao</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.luilaykhao.app</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>luilaykhao</string>
				</array>
			</dict>
		</array>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>https</string>
		</array>
		<key>NSFaceIDUsageDescription</key>
		<string>ใช้ Face ID เพื่อยืนยันตัวตนในการเข้าสู่ระบบแทนรหัสผ่าน</string>
		<key>NSCameraUsageDescription</key>
		<string>ใช้กล้องเพื่อสแกน QR และอัปโหลดหลักฐานการชำระเงิน</string>
		<!-- ขอเฉพาะ "ขณะใช้งาน" เท่านั้น — ทุกฟีเจอร์ที่ใช้ตำแหน่ง (จุดรับ, ติดตามรถ,
		     แชร์ตำแหน่งในรอบ, บันทึกเส้นทาง) ทำงานตอนแอปเปิดอยู่ ไม่มีที่ไหนเรียก
		     always ถ้าวันไหนทำ background tracking จริง ต้องใส่ UIBackgroundModes =
		     location เพิ่มด้วย -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>ใช้ตำแหน่งของคุณเพื่อแสดงจุดรับ-ส่งที่ใกล้ที่สุด ติดตามรถรับส่งระหว่างทริป และแชร์ตำแหน่งให้เพื่อนร่วมทริปรอบเดียวกันเห็นเมื่อคุณเปิดสวิตช์แชร์เอง</string>
		<!-- คีย์นี้ต้องมี แม้แอปจะไม่เคยขอสิทธิ์ always: GeolocatorPlugin อ้างถึง
		     requestAlwaysAuthorization ในโค้ดของปลั๊กอินเอง ตัวสแกนของ Apple เห็น
		     selector นั้นแล้วตอบ ITMS-90683 ตอนอัปโหลด ไม่ว่าฝั่ง Dart จะเรียกหรือไม่
		     ข้อความนี้จึงไม่เคยถูกแสดงให้ผู้ใช้เห็นจริง แต่ต้องอ่านแล้วตรงกับความจริง
		     เผื่อวันหนึ่งมีอะไรไปเรียกมันเข้า -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>ใช้ตำแหน่งของคุณเพื่อแสดงจุดรับ-ส่งที่ใกล้ที่สุด ติดตามรถรับส่งระหว่างทริป และแชร์ตำแหน่งให้เพื่อนร่วมทริปรอบเดียวกันเห็นเมื่อคุณเปิดสวิตช์แชร์เอง โดยแอปอ่านตำแหน่งเฉพาะตอนที่คุณเปิดแอปอยู่เท่านั้น</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>ใช้รูปภาพเพื่ออัปโหลดโปรไฟล์หรือหลักฐานการชำระเงิน</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>ใช้เพื่อบันทึกรูปภาพจากทริปลงในคลังรูปภาพของคุณ</string>
		<key>NSCalendarsUsageDescription</key>
		<string>ใช้เพื่อเพิ่มวันเดินทางของทริปลงในปฏิทินของคุณ</string>
		<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
		<string>ใช้เพื่อเพิ่มวันเดินทางของทริปลงในปฏิทินของคุณ</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- แอปเข้ารหัสเฉพาะ HTTPS กับ Keychain ซึ่งเข้าข่ายยกเว้นของ Apple
		     ประกาศไว้ตรงนี้เพื่อไม่ต้องตอบคำถาม export compliance ทุกครั้งที่อัปโหลด build -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<!-- การ์ด "วันเดินทาง" บนหน้าจอล็อก / Dynamic Island -->
		<key>NSSupportsLiveActivities</key>
		<true/>
		<!-- ยิงอัปเดตถี่ระดับนาทีได้ ไม่โดนระบบหรี่ทิ้ง — ETA ที่ช้าไป 5 นาทีคือ ETA ที่ผิด
		     (ผู้ใช้ปิดได้เองในตั้งค่า > แอป > Live Activities) -->
		<key>NSSupportsLiveActivitiesFrequentUpdates</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
