<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Luilaykhao</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>GMSApiKey</key>
		<string>$(GOOGLE_MAPS_API_KEY)</string>
		<key>CFBundleName</key>
		<string>Luilaykhao</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.luilaykhao.app</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>luilaykhao</string>
				</array>
			</dict>
		</array>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>https</string>
		</array>
		<key>NSFaceIDUsageDescription</key>
		<string>ใช้ Face ID เพื่อยืนยันตัวตนในการเข้าสู่ระบบแทนรหัสผ่าน</string>
		<key>NSCameraUsageDescription</key>
		<string>ใช้กล้องเพื่อสแกน QR ถ่ายเอกสารที่ทริปขอ และอัปโหลดหลักฐานการชำระเงิน</string>
		<!-- ยังขอเฉพาะ "ขณะใช้งาน" เท่านั้น ไม่เคยขอ always

		     สองฟีเจอร์ (บันทึกเส้นทางเดินป่า, แชร์ตำแหน่งให้เพื่อนร่วมทริป) อ่าน
		     ตำแหน่งต่อหลังผู้ใช้ปิดหน้าจอ ซึ่ง iOS อนุญาตให้ทำได้ด้วยสิทธิ์ "ขณะ
		     ใช้งาน" ตราบใดที่ตั้ง allowsBackgroundLocationUpdates = YES และมี
		     UIBackgroundModes = location ข้างล่าง โดยระบบจะขึ้นแถบสีฟ้าให้ผู้ใช้
		     เห็นตลอดเวลาที่อ่านอยู่ — จึงไม่ต้องไปรบกวนขอสิทธิ์ always ซึ่งกว้าง
		     เกินกว่าที่ฟีเจอร์พวกนี้ต้องการจริง

		     หมายเหตุ: ถ้าลบ location ออกจาก UIBackgroundModes ข้างล่าง ปลั๊กอินจะ
		     ปิดโหมดเบื้องหลังให้เองเงียบ ๆ (GeolocationHandler.m —
		     shouldEnableBackgroundLocationUpdates) ฟีเจอร์จะไม่พังให้เห็น แต่จะ
		     กลับไปตายตอนล็อกหน้าจอเหมือนเดิม -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>ใช้ตำแหน่งของคุณเพื่อแสดงจุดรับ-ส่งที่ใกล้ที่สุด ติดตามรถรับส่งระหว่างทริป บันทึกเส้นทางที่คุณเดิน และแชร์ตำแหน่งให้เพื่อนร่วมทริปรอบเดียวกันเห็นเมื่อคุณเปิดสวิตช์เอง สองอย่างหลังจะอ่านตำแหน่งต่อแม้คุณปิดหน้าจอ โดยมีแถบสีแสดงให้เห็นตลอดและหยุดได้ทุกเมื่อในแอป</string>
		<!-- คีย์นี้ต้องมี แม้แอปจะไม่เคยขอสิทธิ์ always: GeolocatorPlugin อ้างถึง
		     requestAlwaysAuthorization ในโค้ดของปลั๊กอินเอง ตัวสแกนของ Apple เห็น
		     selector นั้นแล้วตอบ ITMS-90683 ตอนอัปโหลด ไม่ว่าฝั่ง Dart จะเรียกหรือไม่
		     ข้อความนี้จึงไม่เคยถูกแสดงให้ผู้ใช้เห็นจริง แต่ต้องอ่านแล้วตรงกับความจริง
		     เผื่อวันหนึ่งมีอะไรไปเรียกมันเข้า -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>ใช้ตำแหน่งของคุณเพื่อแสดงจุดรับ-ส่งที่ใกล้ที่สุด ติดตามรถรับส่งระหว่างทริป บันทึกเส้นทางที่คุณเดิน และแชร์ตำแหน่งให้เพื่อนร่วมทริปรอบเดียวกันเห็นเมื่อคุณเปิดสวิตช์เอง โดยแอปอ่านตำแหน่งเฉพาะตอนที่คุณสั่งให้ทำงานเท่านั้น</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>ใช้รูปภาพเพื่ออัปโหลดโปรไฟล์ เอกสารที่ทริปขอ หลักฐานการชำระเงิน และใส่รูปของคุณลงการ์ดแชร์ทริป</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>ใช้เพื่อบันทึกรูปภาพจากทริปลงในคลังรูปภาพของคุณ</string>
		<key>NSCalendarsUsageDescription</key>
		<string>ใช้เพื่อเพิ่มวันเดินทางของทริปลงในปฏิทินของคุณ</string>
		<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
		<string>ใช้เพื่อเพิ่มวันเดินทางของทริปลงในปฏิทินของคุณ</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- แอปเข้ารหัสเฉพาะ HTTPS กับ Keychain ซึ่งเข้าข่ายยกเว้นของ Apple
		     ประกาศไว้ตรงนี้เพื่อไม่ต้องตอบคำถาม export compliance ทุกครั้งที่อัปโหลด build -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<!-- บันทึกเส้นทางเดินป่ากับแชร์ตำแหน่งให้เพื่อนร่วมทริป ต้องอ่าน GPS ต่อ
			     หลังผู้ใช้ปิดหน้าจอ ทริปหนึ่งเดินกันหลายชั่วโมง ไม่มีใครถือเครื่อง
			     เปิดหน้าจอค้างไว้ตลอดทาง -->
			<string>location</string>
			<string>remote-notification</string>
		</array>
		<!-- การ์ด "วันเดินทาง" บนหน้าจอล็อก / Dynamic Island -->
		<key>NSSupportsLiveActivities</key>
		<true/>
		<!-- ยิงอัปเดตถี่ระดับนาทีได้ ไม่โดนระบบหรี่ทิ้ง — ETA ที่ช้าไป 5 นาทีคือ ETA ที่ผิด
		     (ผู้ใช้ปิดได้เองในตั้งค่า > แอป > Live Activities) -->
		<key>NSSupportsLiveActivitiesFrequentUpdates</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
