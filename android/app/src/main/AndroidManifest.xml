<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      บันทึกเส้นทางเดินป่ากับแชร์ตำแหน่งให้เพื่อนร่วมทริป ต้องอ่าน GPS ต่อหลังผู้ใช้
      กดล็อกหน้าจอ — ไม่งั้นเส้นทางขาดทุกครั้งที่เก็บเครื่องลงกระเป๋า

      ทำผ่าน foreground service ของ geolocator (มันประกาศ service พร้อม
      foregroundServiceType="location" มาให้ในปลั๊กอินแล้ว) จึงต้องการแค่สองสิทธิ์
      นี้ ตั้งใจ *ไม่* ขอ ACCESS_BACKGROUND_LOCATION ซึ่งจะทำให้แอปลูกค้าต้องยื่น
      แบบฟอร์มขออนุมัติกับ Play Store ทั้งที่ไม่ได้ต้องการอะไรเกินไปกว่านี้ — งาน
      ทั้งสองอย่างเริ่มจากผู้ใช้กดปุ่มในแอปเสมอ ซึ่งเป็นเงื่อนไขที่ foreground
      service ครอบคลุมอยู่แล้ว
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ข้อความเสียงในห้องแชททริป — ขอสิทธิ์ตอนผู้ใช้กดปุ่มไมค์ครั้งแรกเท่านั้น -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ปลุกรวมในห้องแชท (WakeAlarmService) — ตั้งปลุกในเครื่องให้ดังตรงเวลาแม้ไม่มีสัญญาณ
         Android 14+ ไม่ให้สิทธิ์นี้เอง แอปพาไปเปิดในตั้งค่าจากการ์ดปลุก ไม่มีสิทธิ์ก็ยังปลุกได้
         แบบช้าไม่กี่นาที / BOOT_COMPLETED = เปิดเครื่องใหม่หรืออัปเดตแอปแล้วปลุกยังอยู่ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- บันทึกการ์ดแชร์ลงคลังรูป (แพ็กเกจ gal) — Android 10 ลงไปต้องขอสิทธิ์เขียน
         ที่เก็บข้อมูล ตั้งแต่ 11 ขึ้นไปเขียนผ่าน MediaStore ได้เองไม่ต้องขอ -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="Luilaykhao"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="auth"
                    android:pathPrefix="/social/callback"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="tracking"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/tracking"/>
            </intent-filter>
            <!-- App Links: https://luilaykhao.com/gift/* เปิดแอปโดยตรง (ต้องมี assetlinks.json)
                 autoVerify ให้ Android ตรวจ /.well-known/assetlinks.json อัตโนมัติ -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/gift"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="gift"/>
            </intent-filter>
            <!-- บัตรของขวัญแบบระบุยอด — ผู้รับที่มีแอปเพิ่มบัตรเข้าบัญชีได้เลย
                 (ไม่มีแอปก็เปิดหน้าเว็บ /voucher/* ที่บอกวิธีใช้) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/voucher"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="voucher"/>
            </intent-filter>
            <!-- ลิงก์ส่งต่อที่นั่ง — คนรับมีแอปก็รับที่นั่งในแอปเลย (ไม่มีก็เปิดหน้าเว็บ
                 /handover/* ใน SPA ซึ่งรับได้เหมือนกัน) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/handover"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="handover"/>
            </intent-filter>
            <!-- SMS "ทีมงานเปิดการจองให้คุณแล้ว" — มีแอปก็รับการจองเข้าบัญชีที่ล็อกอินอยู่
                 (LINE/Google/อีเมล) ได้เลย ไม่มีแอปก็เปิดหน้าเว็บ /claim/* ตั้งรหัสผ่านตามเดิม
                 prefix มี "/" ปิดท้าย ไม่งั้นจะกินหน้า /claim-done ที่ต้องเปิดในเว็บไปด้วย -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/claim/"/>
            </intent-filter>
            <!-- luilaykhao://claim/TOKEN (ปุ่ม "เปิดในแอป" บนหน้าเว็บ /claim) แยกไว้อีกตัว —
                 ถ้าอยู่รวมกับข้างบน pathPrefix จะถูกใช้กับ scheme นี้ด้วย แล้ว path "/TOKEN"
                 ไม่ตรง "/claim/" ลิงก์จะไม่เปิดแอป -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="claim"/>
            </intent-filter>
            <!-- คำเชิญเข้าการจอง — ปุ่ม "เข้าร่วมทริปในแอป" บนลิงก์ของเพื่อน (/f/) ชี้มา
                 /join/* มีแอปก็รับคำเชิญในแอปเลย ไม่มีก็เปิดหน้าเว็บ /join ใน SPA -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/join"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="join"/>
            </intent-filter>
            <!-- ลิงก์ตั้งรหัสผ่านใหม่จากอีเมล — เปิดหน้าตั้งรหัสผ่านในแอปแทนเบราว์เซอร์
                 (ถ้า assetlinks.json ยังไม่ผ่านการตรวจ Android จะเปิดเว็บให้ตามเดิม
                 หน้า /reset-password ใน SPA ทำงานได้เหมือนกัน จึงไม่มีทางตัน) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="luilaykhao.com"
                    android:pathPrefix="/reset-password"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="reset-password"/>
            </intent-filter>
            <!-- แตะวิดเจ็ตหน้าโฮมแล้วเปิดหน้าการจอง — วิดเจ็ตยิง explicit intent มา
                 ตรง ๆ อยู่แล้ว แต่ตัวกรองนี้ทำให้ลิงก์ luilaykhao://booking/REF ที่มา
                 จากที่อื่น (อีเมล, ข้อความ) เปิดในแอปด้วย ฝั่ง Dart รองรับ host นี้อยู่
                 แล้วใน NotificationNavigator.handleDeepLink -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="luilaykhao"
                    android:host="booking"/>
            </intent-filter>
        </activity>

        <!-- ปลุกรวมในห้องแชท (WakeAlarmService) — แจ้งเตือนที่ตั้งเวลาไว้ในเครื่อง ดังได้แม้
             ตอนนั้นไม่มีสัญญาณ ตัวรับของ flutter_local_notifications ต้องประกาศเอง -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- วิดเจ็ตนับถอยหลังทริปบนหน้าโฮม (ดู TripCountdownWidget.kt)
             ต้อง exported=true เพราะ launcher เป็นคนส่ง broadcast มาให้ -->
        <receiver
            android:name=".TripCountdownWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trip_countdown_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="important_updates" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- add_2_calendar: allow launching the calendar insert composer -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>
</manifest>
